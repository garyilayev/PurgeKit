// PurgeKit UI. Three destinations: Clean, Space, Settings.
// The UI never touches the file system; Rust pushes batched model updates.

import { Button, ComboBox, LineEdit, ListView, ScrollView, Switch, ProgressIndicator, Palette } from "std-widgets.slint";

export struct CategoryRow {
    node: int,
    name: string,
    size: string,
    check: int, // 0 unchecked, 1 checked, 2 partial
}

export struct TreeRow {
    node: int,          // -1 for aggregate rows
    depth: int,
    name: string,
    size: string,
    modified: string,
    safety: string,
    check: int,
    expandable: bool,
    expanded: bool,
    aggregate: bool,
    blocked: bool,
}

export struct SkipRow {
    text: string,
    details: string,
    retry: bool,
}

export struct DriveRow {
    name: string,
    used-frac: float,
    clean-frac: float,
    text: string,
}

export struct TextRow {
    text: string,
}

export struct DetailsData {
    visible: bool,
    title: string,
    what: string,
    why: string,
    after: string,
    location: string,
    size: string,
    files: string,
    modified: string,
    rule: string,
    tier: string,
}

export global App {
    // Navigation
    in-out property <int> page: 0;          // 0 Clean, 1 Space, 2 Settings
    in-out property <int> clean-state: 0;   // 0 idle, 1 scanning, 2 results, 3 review, 4 cleaning, 5 done
    in property <string> notice;

    // Home
    in property <string> scan-text;
    in property <string> headline;
    in property <string> partial-note;
    in property <string> clean-label;
    in property <bool> can-clean;
    in property <[CategoryRow]> categories;
    in property <[TextRow]> blocked;
    in property <string> footer;
    in property <string> advanced-hint;

    // Review
    in property <[TreeRow]> rows;
    in-out property <int> current-row: -1;
    in property <DetailsData> details;
    in property <string> selection-summary;

    // Cleaning / done
    in property <string> clean-progress-text;
    in property <float> clean-progress;
    in property <string> done-headline;
    in property <string> done-sub;
    in property <string> gap-note;
    in property <[SkipRow]> skips;

    // Space
    in property <[DriveRow]> drives;
    in property <string> space-note;

    // Settings
    in property <bool> scan-on-launch;
    in property <bool> show-advanced;
    in property <[TextRow]> exclusions;
    in property <[TextRow]> history;
    in property <string> about;
    in property <string> diagnostics-status;

    callback scan();
    callback cancel();
    callback clean();
    callback review();
    callback back-home();
    callback done();
    callback retry();
    callback dismiss-notice();
    callback toggle-category(int);
    callback toggle-row(int);
    callback expand-row(int);
    callback select-row(int);
    callback search-changed(string);
    callback sort-changed(int);
    callback open-location(int);
    callback copy-path(int);
    callback exclude-row(int);
    callback set-scan-on-launch(bool);
    callback set-show-advanced(bool);
    callback remove-exclusion(int);
    callback export-diagnostics();
    callback check-updates();
}

component TriCheck inherits Rectangle {
    in property <int> check;
    in property <string> label;
    callback toggled();
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border-width: root.check == 0 ? 1px : 0px;
    border-color: Palette.border;
    background: root.check == 0 ? transparent : Palette.accent-background;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.check == 1;
    accessible-action-default => { root.toggled(); }
    Text {
        text: root.check == 1 ? "✓" : root.check == 2 ? "–" : "";
        color: Palette.accent-foreground;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback activated();
    min-width: 96px;
    height: 44px;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    Text {
        text: root.label;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        color: Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        width: root.active ? 32px : 0px;
        x: (parent.width - self.width) / 2;
        border-radius: 2px;
        background: Palette.accent-background;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

component Muted inherits Text {
    color: Palette.foreground.with-alpha(0.65);
    wrap: word-wrap;
}

component Footer inherits Muted {
    text: App.footer;
    font-size: 12px;
    horizontal-alignment: center;
}

// ---------------------------------------------------------------- Home

component IdleView inherits VerticalLayout {
    alignment: center;
    spacing: 16px;
    padding: 24px;
    Text {
        text: @tr("See what's wasting space.");
        font-size: 26px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Muted {
        text: @tr("PurgeKit looks only for files it can explain, and removes nothing until you say so.");
        horizontal-alignment: center;
    }
    HorizontalLayout {
        alignment: center;
        Button {
            text: @tr("Scan PC");
            primary: true;
            min-width: 160px;
            clicked => { App.scan(); }
        }
    }
    Footer { }
}

component ScanningView inherits VerticalLayout {
    alignment: center;
    spacing: 16px;
    padding: 24px;
    Text {
        text: App.scan-text;
        font-size: 18px;
        horizontal-alignment: center;
        accessible-role: text;
    }
    HorizontalLayout {
        alignment: center;
        ProgressIndicator {
            indeterminate: true;
            width: 240px;
            height: 6px;
        }
    }
    HorizontalLayout {
        alignment: center;
        Button {
            text: @tr("Cancel");
            clicked => { App.cancel(); }
        }
    }
}

component ResultsView inherits VerticalLayout {
    spacing: 14px;
    padding: 24px;
    Text {
        text: App.headline;
        font-size: 24px;
        font-weight: 600;
    }
    if App.partial-note != "": Muted { text: App.partial-note; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: 2px;
            for cat in App.categories: Rectangle {
                height: 44px;
                border-radius: 6px;
                background: area.has-hover ? Palette.alternate-background : transparent;
                area := TouchArea {
                    clicked => { App.toggle-category(cat.node); }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    TriCheck {
                        y: (parent.height - self.height) / 2;
                        check: cat.check;
                        label: cat.name;
                        toggled => { App.toggle-category(cat.node); }
                    }
                    Text {
                        text: cat.name;
                        font-size: 15px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: cat.size;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                }
            }
            for b in App.blocked: Muted {
                text: b.text;
                font-size: 13px;
            }
            if App.advanced-hint != "": Muted {
                text: App.advanced-hint;
                font-size: 12px;
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Button {
            text: App.clean-label;
            primary: true;
            enabled: App.can-clean;
            clicked => { App.clean(); }
        }
        Button {
            text: @tr("Review files");
            clicked => { App.review(); }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: @tr("Rescan");
            clicked => { App.scan(); }
        }
    }
    Footer { horizontal-alignment: left; }
}

// ---------------------------------------------------------------- Review (Cleanup Explorer)

component TreeRowView inherits Rectangle {
    in property <TreeRow> item;
    in property <bool> current;
    in property <bool> wide;
    height: 30px;
    background: root.current ? Palette.selection-background.with-alpha(0.35) : area.has-hover ? Palette.alternate-background : transparent;
    accessible-role: list-item;
    accessible-action-default => {
        if (root.item.expandable) { App.expand-row(root.item.node); } else { App.select-row(root.item.node); }
    }
    accessible-label: root.item.name + ", " + root.item.size + (root.item.check == 1 ? ", checked" : root.item.check == 2 ? ", partly checked" : ", not checked");
    area := TouchArea {
        clicked => { App.select-row(root.item.node); }
        double-clicked => { if (root.item.expandable) { App.expand-row(root.item.node); } }
    }
    ContextMenuArea {
        enabled: !root.item.aggregate;
        Menu {
            MenuItem {
                title: @tr("Open location");
                activated => { App.open-location(root.item.node); }
            }
            MenuItem {
                title: @tr("Copy path");
                activated => { App.copy-path(root.item.node); }
            }
            MenuItem {
                title: @tr("Show details");
                activated => { App.select-row(root.item.node); }
            }
            MenuItem {
                title: @tr("Exclude (never suggest again)");
                activated => { App.exclude-row(root.item.node); }
            }
            if root.item.expandable: MenuItem {
                title: @tr("Select all");
                activated => { if (root.item.check != 1) { App.toggle-row(root.item.node); } }
            }
            if root.item.expandable: MenuItem {
                title: @tr("Deselect all");
                activated => { if (root.item.check != 0) { App.toggle-row(root.item.node); } }
            }
        }
    }
    HorizontalLayout {
        padding-left: 8px + root.item.depth * 18px;
        padding-right: 12px;
        spacing: 8px;
        Rectangle {
            width: 14px;
            // Drawn chevrons: the renderer's fallback fonts may lack arrow glyphs.
            if root.item.expandable && !root.item.expanded: Path {
                x: 4px;
                y: (parent.height - 10px) / 2;
                width: 6px;
                height: 10px;
                commands: "M 0 0 L 5 5 L 0 10";
                stroke: Palette.foreground.with-alpha(0.7);
                stroke-width: 1.5px;
            }
            if root.item.expandable && root.item.expanded: Path {
                x: 2px;
                y: (parent.height - 6px) / 2;
                width: 10px;
                height: 6px;
                commands: "M 0 0 L 5 5 L 10 0";
                stroke: Palette.foreground.with-alpha(0.7);
                stroke-width: 1.5px;
            }
            TouchArea {
                enabled: root.item.expandable;
                clicked => { App.expand-row(root.item.node); }
            }
        }
        if !root.item.aggregate: TriCheck {
            y: (parent.height - self.height) / 2;
            check: root.item.check;
            label: root.item.name;
            toggled => { App.toggle-row(root.item.node); }
        }
        Text {
            text: root.item.name;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: root.item.aggregate || root.item.blocked ? Palette.foreground.with-alpha(0.6) : Palette.foreground;
            font-italic: root.item.aggregate;
        }
        if wide: Text {
            text: root.item.modified;
            width: 110px;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.65);
        }
        if wide: Text {
            text: root.item.safety;
            width: 70px;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.65);
        }
        Text {
            text: root.item.size;
            width: 80px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component DetailsPanel inherits Rectangle {
    width: 300px;
    background: Palette.alternate-background;
    border-radius: 8px;
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 16px;
            spacing: 10px;
            if !App.details.visible: Muted { text: @tr("Select an item to see what it is, why it is safe, and what happens after you remove it."); }
            if App.details.visible: VerticalLayout {
                spacing: 10px;
                Text { text: App.details.title; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                Text { text: @tr("What it is"); font-weight: 600; }
                Muted { text: App.details.what; }
                Text { text: @tr("Why it is safe"); font-weight: 600; }
                Muted { text: App.details.why; }
                Text { text: @tr("What happens after"); font-weight: 600; }
                Muted { text: App.details.after; }
                Rectangle { height: 1px; background: Palette.border; }
                Muted { text: @tr("Location: {}", App.details.location); font-size: 12px; }
                Muted { text: @tr("Size: {} · {}", App.details.size, App.details.files); font-size: 12px; }
                Muted { text: @tr("Last modified: {}", App.details.modified); font-size: 12px; }
                Muted { text: @tr("Rule: {} · {}", App.details.rule, App.details.tier); font-size: 12px; }
            }
        }
    }
}

component ReviewView inherits VerticalLayout {
    in property <length> window-width;
    padding: 16px;
    spacing: 10px;
    HorizontalLayout {
        spacing: 10px;
        Button {
            text: @tr("Back");
            clicked => { App.back-home(); }
        }
        search := LineEdit {
            placeholder-text: @tr("Search results…");
            horizontal-stretch: 1;
            edited(text) => { App.search-changed(text); }
        }
        ComboBox {
            model: [@tr("Sort by size"), @tr("Sort by name"), @tr("Sort by date")];
            current-index: 0;
            selected => { App.sort-changed(self.current-index); }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        vertical-stretch: 1;
        keys := FocusScope {
            horizontal-stretch: 1;
            key-pressed(event) => {
                if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                    search.focus();
                    return accept;
                }
                if (App.rows.length == 0) { return reject; }
                if (event.text == Key.DownArrow) {
                    App.current-row = Math.min(App.current-row + 1, App.rows.length - 1);
                    App.select-row(App.rows[App.current-row].node);
                    list.content-y = Math.min(0px, Math.max(list.content-y, -(App.current-row * 30px)));
                    if (-list.content-y + list.visible-height < (App.current-row + 1) * 30px) {
                        list.content-y = -((App.current-row + 1) * 30px - list.visible-height);
                    }
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    App.current-row = Math.max(App.current-row - 1, 0);
                    App.select-row(App.rows[App.current-row].node);
                    if (-list.content-y > App.current-row * 30px) {
                        list.content-y = -(App.current-row * 30px);
                    }
                    return accept;
                }
                if (App.current-row < 0) { return reject; }
                if (event.text == " ") {
                    App.toggle-row(App.rows[App.current-row].node);
                    return accept;
                }
                if (event.text == Key.Return || event.text == Key.RightArrow) {
                    if (App.rows[App.current-row].expandable && (event.text == Key.Return || !App.rows[App.current-row].expanded)) {
                        App.expand-row(App.rows[App.current-row].node);
                    }
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    if (App.rows[App.current-row].expanded) {
                        App.expand-row(App.rows[App.current-row].node);
                    }
                    return accept;
                }
                return reject;
            }
            Rectangle {
                border-radius: 8px;
                clip: true;
                list := ListView {
                    for r[i] in App.rows: TreeRowView {
                        item: r;
                        current: i == App.current-row;
                        wide: root.window-width > 900px;
                    }
                }
                // Drawn after the list so hovered or selected row backgrounds cannot paint over the frame.
                Rectangle {
                    border-width: 1px;
                    border-color: keys.has-focus ? Palette.accent-background : Palette.border;
                    border-radius: 8px;
                }
            }
        }
        if root.window-width > 720px: DetailsPanel { }
    }
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: App.selection-summary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Button {
            text: App.clean-label;
            primary: true;
            enabled: App.can-clean;
            clicked => { App.clean(); }
        }
    }
    init => { keys.focus(); }
}

component CleaningView inherits VerticalLayout {
    alignment: center;
    spacing: 16px;
    padding: 24px;
    Text {
        text: App.clean-progress-text;
        font-size: 18px;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        alignment: center;
        ProgressIndicator {
            progress: App.clean-progress;
            width: 320px;
            height: 6px;
        }
    }
    HorizontalLayout {
        alignment: center;
        Button {
            text: @tr("Cancel");
            clicked => { App.cancel(); }
        }
    }
}

component SkipView inherits VerticalLayout {
    in property <SkipRow> skip;
    property <bool> open: false;
    spacing: 4px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Text {
            text: root.skip.text;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.skip.retry: Button {
            text: @tr("Retry");
            clicked => { App.retry(); }
        }
        if root.skip.details != "": Button {
            text: root.open ? @tr("Hide details") : @tr("Details");
            clicked => { root.open = !root.open; }
        }
    }
    if open: Muted {
        text: root.skip.details;
        font-size: 12px;
    }
}

component DoneView inherits VerticalLayout {
    spacing: 14px;
    padding: 24px;
    Text {
        text: App.done-headline;
        font-size: 24px;
        font-weight: 600;
    }
    Muted { text: App.done-sub; }
    if App.gap-note != "": Muted { text: App.gap-note; font-size: 12px; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: 10px;
            for s in App.skips: SkipView { skip: s; }
        }
    }
    HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("Done");
            primary: true;
            clicked => { App.done(); }
        }
    }
}

component CleanPage inherits Rectangle {
    in property <length> window-width;
    if App.clean-state == 0: IdleView { }
    if App.clean-state == 1: ScanningView { }
    if App.clean-state == 2: ResultsView { }
    if App.clean-state == 3: ReviewView { window-width: root.window-width; }
    if App.clean-state == 4: CleaningView { }
    if App.clean-state == 5: DoneView { }
}

// ---------------------------------------------------------------- Space

component SpacePage inherits VerticalLayout {
    padding: 24px;
    spacing: 18px;
    Text {
        text: @tr("Drives");
        font-size: 22px;
        font-weight: 600;
    }
    for d in App.drives: VerticalLayout {
        spacing: 6px;
        Text { text: d.name; font-size: 15px; font-weight: 600; }
        Rectangle {
            height: 14px;
            border-radius: 7px;
            background: Palette.alternate-background;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * d.used-frac;
                background: Palette.foreground.with-alpha(0.35);
            }
            Rectangle {
                x: parent.width * (d.used-frac - d.clean-frac);
                width: parent.width * d.clean-frac;
                background: Palette.accent-background;
            }
        }
        Muted { text: d.text; font-size: 12px; }
    }
    Muted { text: App.space-note; font-size: 12px; }
    Rectangle { vertical-stretch: 1; }
}

// ---------------------------------------------------------------- Settings

component Section inherits Text {
    font-size: 16px;
    font-weight: 600;
}

component SettingsPage inherits ScrollView {
    VerticalLayout {
        alignment: start;
        padding: 24px;
        spacing: 12px;
        Section { text: @tr("General"); }
        Switch {
            text: @tr("Scan when PurgeKit starts");
            checked: App.scan-on-launch;
            toggled => { App.set-scan-on-launch(self.checked); }
        }
        Switch {
            text: @tr("Show advanced items");
            checked: App.show-advanced;
            toggled => { App.set-show-advanced(self.checked); }
        }
        Muted { text: @tr("Advanced items are system files. They are never selected for you, and removing some of them asks for administrator permission."); font-size: 12px; }

        Section { text: @tr("Exclusions"); }
        if App.exclusions.length == 0: Muted { text: @tr("No exclusions. In Review, right-click an item and choose Exclude to stop suggesting it."); }
        for e[i] in App.exclusions: HorizontalLayout {
            spacing: 10px;
            Text { text: e.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Button {
                text: @tr("Remove");
                clicked => { App.remove-exclusion(i); }
            }
        }

        Section { text: @tr("History"); }
        if App.history.length == 0: Muted { text: @tr("No cleans yet."); }
        for h in App.history: Muted { text: h.text; font-size: 13px; }

        Section { text: @tr("Privacy"); }
        Muted { text: @tr("This version of PurgeKit contains no networking code. It never connects to the internet and sends no data. Settings, exclusions, history and logs stay on this PC in %LOCALAPPDATA%\\PurgeKit."); }

        Section { text: @tr("About"); }
        Muted { text: App.about; }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Button {
                text: @tr("Export diagnostics");
                clicked => { App.export-diagnostics(); }
            }
            Button {
                text: @tr("Check for updates");
                clicked => { App.check-updates(); }
            }
        }
        if App.diagnostics-status != "": Muted { text: App.diagnostics-status; font-size: 12px; }
    }
}

// ---------------------------------------------------------------- Window

export component AppWindow inherits Window {
    title: "PurgeKit";
    icon: @image-url("purgekit.png");
    preferred-width: 960px;
    preferred-height: 660px;
    min-width: 560px;
    min-height: 480px;
    background: Palette.background;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 12px;
            spacing: 4px;
            alignment: start;
            NavItem {
                label: @tr("Clean");
                active: App.page == 0;
                activated => { App.page = 0; }
            }
            NavItem {
                label: @tr("Space");
                active: App.page == 1;
                activated => { App.page = 1; }
            }
            NavItem {
                label: @tr("Settings");
                active: App.page == 2;
                activated => { App.page = 2; }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }
        if App.notice != "": Rectangle {
            background: Palette.alternate-background;
            height: 40px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 8px;
                Text { text: App.notice; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Button {
                    text: @tr("Dismiss");
                    clicked => { App.dismiss-notice(); }
                }
            }
        }
        if App.page == 0: CleanPage { window-width: root.width; vertical-stretch: 1; }
        if App.page == 1: SpacePage { vertical-stretch: 1; }
        if App.page == 2: SettingsPage { vertical-stretch: 1; }
    }
}
